# Copy to `.env.local`. Worker base URL + student app URL (local dev defaults).
NEXT_PUBLIC_API_URL="http://localhost:8787"
NEXT_PUBLIC_STUDENT_URL="http://localhost:5173"

# Server-only question generation (Next.js route handler, never sent to the browser).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
