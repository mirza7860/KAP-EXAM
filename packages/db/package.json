{
  "name": "@kap-exam/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "migrate:local": "wrangler d1 migrations apply kap-exam --local --config ../../apps/api/wrangler.toml",
    "migrate:remote": "wrangler d1 migrations apply kap-exam --remote --config ../../apps/api/wrangler.toml",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rimraf .turbo dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "drizzle-kit": "^0.30.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
